{
  "name": "terrakube-action-github",
  "version": "2.0.0",
  "description": "GitHub Action for Terrakube",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.ts -o dist --minify --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --import tsx --test \"__tests__/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format-check && npm test",
    "check-bundle": "node scripts/check-bundle.mjs"
  },
  "repository": "git+https://github.com/terrakube-io/terrakube-action-github.git",
  "author": "Alfredo España <alfespa17@gmail.com>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@actions/glob": "^0.7.0",
    "undici": "^8.12.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.13.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "type": "module",
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "bugs": {
    "url": "https://github.com/terrakube-io/terrakube-action-github/issues"
  },
  "homepage": "https://github.com/terrakube-io/terrakube-action-github#readme"
}
